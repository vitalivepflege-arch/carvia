generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  BUYER
  SALES
  VIEWER
}

enum ProviderStatus {
  CONNECTED
  NOT_CONFIGURED
  DISABLED
  ERROR
}

enum ProviderSyncMode {
  MANUAL
  SCHEDULED
  PAUSED
}

enum WatchlistStage {
  NEW
  REVIEWING
  NEGOTIATING
  READY_TO_BUY
  PASSED
}

enum WatchlistPriority {
  LOW
  MEDIUM
  HIGH
}

enum WatchlistOfferStatus {
  NONE
  PREPARING
  OFFER_SENT
  COUNTER_RECEIVED
  ACCEPTED
  REJECTED
}

enum WatchlistClosingStatus {
  NONE
  PAPERWORK_PENDING
  PAYMENT_PENDING
  TRANSPORT_BOOKED
  COMPLETED
  CANCELLED
}

enum WatchlistRetailStatus {
  NONE
  RECONDITIONING
  MEDIA_PENDING
  LISTING_READY
  LIVE
  SOLD
}

enum WatchlistSalesStatus {
  NONE
  LEAD_NEW
  RESERVATION_PENDING
  TEST_DRIVE_SCHEDULED
  NEGOTIATING
  WON
  LOST
}

enum TaskStatus {
  OPEN
  DONE
}

enum WatchlistActivityType {
  CALL
  EMAIL
  MESSAGE
  DOCUMENT
  MEETING
  NOTE
}

enum ContactChannel {
  CALL
  EMAIL
  MESSAGE
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  name                 String?
  role                 UserRole  @default(VIEWER)
  companyId            String?
  company              Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  onboardingCompletedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Company {
  id                   String            @id @default(cuid())
  name                 String
  vatId                String?
  contactEmail         String?
  contactPhone         String?
  preferredBrands      String[]
  averagePurchaseBudget Decimal?        @db.Decimal(12, 2)
  minimumMarginTarget  Decimal?          @db.Decimal(12, 2)
  targetDaysToSell     Int?
  users                User[]
  locations            DealerLocation[]
  profiles             DealerProfile[]
  analyses             VehicleAnalysis[]
  watchlistItems       Watchlist[]
  watchlistActivities  WatchlistActivity[]
  watchlistContacts    WatchlistContact[]
  watchlistTasks       WatchlistTask[]
  savedSearches        SavedSearch[]
  importRuns           ImportRun[]
  notificationPreference NotificationPreference?
  notificationDigestRuns NotificationDigestRun[]
  automationRuns       AutomationRun[]
  providers            ProviderCredential[]
  providerSyncRuns     ProviderSyncRun[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model DealerProfile {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companySize     String?
  targetStockTurn Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DealerLocation {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  country     String
  postalCode  String
  city        String?
  street      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id                String                 @id @default(cuid())
  provider          String
  providerVehicleId String?
  make              String
  model             String
  firstRegistration DateTime?
  mileageKm         Int?
  fuelType          String?
  powerHp           Int?
  transmission      String?
  driveType         String?
  priceGross        Decimal?               @db.Decimal(12, 2)
  country           String?
  postalCode        String?
  listingUrl        String?
  firstSeenAt       DateTime?
  lastSeenAt        DateTime?
  removedAt         DateTime?
  listings          VehicleListing[]
  snapshots         VehicleListingSnapshot[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([provider, providerVehicleId])
  @@unique([provider, providerVehicleId])
  @@index([make, model])
}

model VehicleListing {
  id             String                 @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  sourceProvider String
  askingPrice    Decimal?               @db.Decimal(12, 2)
  sellerType     String?
  status         String?
  snapshots      VehicleListingSnapshot[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model VehicleListingSnapshot {
  id          String         @id @default(cuid())
  vehicleId   String
  listingId   String?
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  listing     VehicleListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  timestamp   DateTime
  price       Decimal?       @db.Decimal(12, 2)
  mileageKm   Int?
  status      String
  provider    String
}

model VehicleAnalysis {
  id                       String    @id @default(cuid())
  companyId                String
  company                  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId                String?
  purchasePrice            Decimal   @db.Decimal(12, 2)
  totalLandedCost          Decimal?  @db.Decimal(12, 2)
  estimatedTransactionPrice Decimal? @db.Decimal(12, 2)
  projectedMargin          Decimal?  @db.Decimal(12, 2)
  dealerScore              Int?
  confidence               Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Watchlist {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId    String
  note         String?
  stage        WatchlistStage    @default(NEW)
  priority     WatchlistPriority @default(MEDIUM)
  offerStatus  WatchlistOfferStatus @default(NONE)
  targetBuyPrice Decimal?        @db.Decimal(12, 2)
  latestOfferPrice Decimal?      @db.Decimal(12, 2)
  counterOfferPrice Decimal?     @db.Decimal(12, 2)
  offerUpdatedAt DateTime?
  closingStatus WatchlistClosingStatus @default(NONE)
  closingTargetDate DateTime?
  paperworkCompletedAt DateTime?
  paymentCompletedAt DateTime?
  handoffCompletedAt DateTime?
  closingUpdatedAt DateTime?
  retailStatus  WatchlistRetailStatus @default(NONE)
  retailAskingPrice Decimal?      @db.Decimal(12, 2)
  retailTargetDate DateTime?
  reconditioningCompletedAt DateTime?
  mediaCompletedAt DateTime?
  listingPublishedAt DateTime?
  soldAt DateTime?
  retailUpdatedAt DateTime?
  salesStatus WatchlistSalesStatus @default(NONE)
  leadCount Int @default(0)
  reservationPlacedAt DateTime?
  testDriveScheduledAt DateTime?
  salesTargetDate DateTime?
  soldRetailPrice Decimal? @db.Decimal(12, 2)
  salesUpdatedAt DateTime?
  transportCost Decimal? @db.Decimal(12, 2)
  reconditioningCost Decimal? @db.Decimal(12, 2)
  holdingCost Decimal? @db.Decimal(12, 2)
  miscCost Decimal? @db.Decimal(12, 2)
  inventoryUpdatedAt DateTime?
  nextActionAt DateTime?
  activities   WatchlistActivity[]
  contacts     WatchlistContact[]
  tasks        WatchlistTask[]
  createdAt    DateTime          @default(now())

  @@index([companyId, vehicleId])
  @@unique([companyId, vehicleId])
}

model WatchlistContact {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  watchlistId       String
  watchlist         Watchlist      @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  fullName          String
  companyName       String?
  roleLabel         String?
  email             String?
  phone             String?
  preferredChannel  ContactChannel @default(CALL)
  notes             String?
  lastContactedAt   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([companyId, createdAt])
  @@index([watchlistId, createdAt])
}

model WatchlistActivity {
  id            String                @id @default(cuid())
  companyId      String
  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  watchlistId    String
  watchlist      Watchlist             @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  type           WatchlistActivityType
  summary        String
  details        String?
  happenedAt     DateTime              @default(now())
  createdByName  String?
  createdAt      DateTime              @default(now())

  @@index([companyId, happenedAt])
  @@index([watchlistId, createdAt])
}

model WatchlistTask {
  id           String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  watchlistId   String
  watchlist     Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  title         String
  assigneeName  String?
  dueAt         DateTime?
  status        TaskStatus @default(OPEN)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([companyId, status, dueAt])
  @@index([watchlistId, createdAt])
}

model ProviderCredential {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  providerKey     String
  status          ProviderStatus @default(NOT_CONFIGURED)
  syncMode        ProviderSyncMode @default(MANUAL)
  cadenceHours    Int?
  nextSyncAt      DateTime?
  credentialsHint String?
  lastSyncAt      DateTime?
  lastErrorAt     DateTime?
  lastErrorMessage String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([companyId, providerKey])
}

model SavedSearch {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name             String
  filters          Json
  alertEnabled     Boolean  @default(false)
  lastRunResultCount Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companyId, createdAt])
}

model ImportRun {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceType    String
  fileName      String?
  rowCount      Int
  importedCount Int
  skippedCount  Int
  warnings      Json
  createdAt     DateTime @default(now())

  @@index([companyId, createdAt])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  companyId      String   @unique
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  digestEnabled  Boolean  @default(true)
  deliveryChannel String  @default("IN_APP")
  recipientEmail String?
  sendHourLocal  Int      @default(8)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model NotificationDigestRun {
  id              String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deliveryChannel  String
  recipientEmail   String?
  status           String
  actionableCount  Int      @default(0)
  preview          String
  sentAt           DateTime @default(now())

  @@index([companyId, sentAt])
}

model AutomationRun {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runType            String
  status             String
  escalatedCount     Int      @default(0)
  updatedCount       Int      @default(0)
  preview            String
  createdAt          DateTime @default(now())

  @@index([companyId, createdAt])
}

model ProviderSyncRun {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  providerKey   String
  status        String
  importedCount Int      @default(0)
  message       String?
  createdAt     DateTime @default(now())

  @@index([companyId, providerKey, createdAt])
}
